# Gremake Website Enquiry API — Environment Variables
# Copy to .env for local development. Never commit .env.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@yourdomain.com

PORT=4000

# Set to your frontend URL for CORS
ALLOWED_ORIGIN=https://gremake.com

NODE_ENV=production

# ── Launch state ────────────────────────────────────────────────────────────
# LAUNCH_SECRET: a strong random string used to authenticate POST /api/launch.
# Generate with: openssl rand -base64 32
# Keep this secret. Never expose it in frontend code, URLs, or logs.
LAUNCH_SECRET=your-strong-random-secret-here

# DATABASE_URL: PostgreSQL connection string for persistent launch state storage.
# The launch_state table is created automatically on startup.
# On Render, use the internal database URL from your Render Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/dbname
